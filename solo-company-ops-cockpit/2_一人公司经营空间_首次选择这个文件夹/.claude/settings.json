{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Glob|Grep|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-write.ps1",
            "timeout": 10,
            "statusMessage": "正在核验操作范围、风险等级与确认状态"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/post-write-audit.ps1",
            "timeout": 5,
            "statusMessage": "正在记录可恢复的写入结果"
          }
        ]
      }
    ]
  }
}
