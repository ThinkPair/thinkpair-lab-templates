{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-write.ps1",
            "timeout": 10,
            "statusMessage": "正在核验写回范围与确认状态"
          }
        ]
      }
    ]
  }
}
