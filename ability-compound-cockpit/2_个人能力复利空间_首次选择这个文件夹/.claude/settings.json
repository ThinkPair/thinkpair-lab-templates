{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/guard-write.ps1",
            "timeout": 20,
            "statusMessage": "正在按风险级别核验能力记录写回"
          }
        ]
      }
    ]
  }
}
